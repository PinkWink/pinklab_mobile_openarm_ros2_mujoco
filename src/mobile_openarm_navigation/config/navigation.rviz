Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Background Color: 35; 39; 46
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: Mobile OpenArm
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Alpha: 0.75
    # --- obstacle view (nav mode): what Nav2 thinks is blocked and what the controller tries ---
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
      Update Topic:
        Value: /global_costmap/costmap_updates
      Color Scheme: costmap
      Alpha: 0.3
      Draw Behind: false
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
      Update Topic:
        Value: /local_costmap/costmap_updates
      Color Scheme: costmap
      Alpha: 0.7
      Draw Behind: false
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic: {Value: /local_costmap/published_footprint}
      Color: 255; 70; 70
    - Class: rviz_default_plugins/MarkerArray
      Name: DWB Trajectories
      Enabled: true
      Topic: {Value: /marker}
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Topic: {Value: /local_plan}
      Color: 255; 200; 0
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.015
      Style: Points
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic: {Value: /plan}
      Color: 80; 210; 150
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: rviz_default_plugins/SetGoal      # publishes /goal_pose; bt_navigator subscribes to it (GoalTool needs the Nav2 panel)
      Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 110
      X: 0
      Y: 0
Window Geometry:
  Width: 1100
  Height: 800
