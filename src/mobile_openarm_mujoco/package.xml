<package format="3">
  <name>mobile_openarm_mujoco</name>
  <version>0.1.0</version>
  <description>Vic Pinky and OpenArm mobile manipulation with ROS 2 Jazzy and MuJoCo.</description>
  <maintainer email="maintainer@example.com">Workspace maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>mobile_openarm_description</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>warehouse_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
</package>
